generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Signal {
  id          Int     @id @default(autoincrement())
  direction   String
  confidence  Int
  priceAtTime Float
  actualChange Float?
  wasCorrect   Boolean?
  createdAt   DateTime @default(now())
}

model WhaleAlert {
  id          Int     @id @default(autoincrement())
  asset       String
  amount      Float
  fromAddress String
  toAddress   String
  seen        Boolean @default(false)
  createdAt   DateTime @default(now())
}
